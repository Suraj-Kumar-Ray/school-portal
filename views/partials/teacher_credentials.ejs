<%#
  ============================================================================
  teacher_credentials.ejs — the login as the office handed it over
  ============================================================================

  The teacher's own login name and password, as ONE warm-coloured chip (`.pf-cred`) with an **👁
  button** (`.pf-eye`) that reveals the password on the tap.

  Printed in ONE place per page, and the school chose which place (2026-09-18):

    • `/teacher` (his dashboard) — beside the “My Dashboard” title, top right,
    • `/teacher/profile`        — inside the “🔑 My login” card's header.

  The password is **never part of the page**: the card ships eight dots, and the tap fetches the
  value from `GET /teacher/login.json` (`Cache-Control: no-store`, his own login only). If the
  office kept no readable copy, the chip says “Ask the office” instead of showing nothing.

  So this file holds the markup AND the script — include it exactly once per page, or the script
  would run twice and two chips would fight over the same ids.
%>
<div class="pf-cred">
  <span class="pf-cred-user" title="Your login name"><span class="pf-cred-ico" aria-hidden="true">👤</span><b><%= teacher.username %></b></span>
  <span class="pf-cred-pass" title="Your password">
    <span class="pf-dots" id="pfPassValue">••••••••</span>
    <button type="button" class="pf-eye" id="pfEye" data-endpoint="/teacher/login.json"
            aria-label="Show my password" aria-pressed="false">👁</button>
  </span>
</div>
<script>
  (function () {
    var eye = document.getElementById('pfEye');
    if (!eye) return;
    var out = document.getElementById('pfPassValue');
    var MASK = '••••••••';
    var plain = null;    // the password, once fetched — kept in memory only, never written to the page
    var shown = false;

    function paint() {
      out.textContent = shown ? plain : MASK;
      var on = shown;
      eye.textContent = on ? '🙈' : '👁';
      eye.setAttribute('aria-pressed', on ? 'true' : 'false');
      eye.setAttribute('aria-label', on ? 'Hide my password' : 'Show my password');
    }

    eye.addEventListener('click', function () {
      if (plain === null) {
        eye.disabled = true;
        fetch(eye.getAttribute('data-endpoint'), { credentials: 'same-origin' })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (d) {
            eye.disabled = false;
            plain = d && d.password ? d.password : '';
            if (!plain) { out.textContent = 'Ask the office'; return; }
            shown = true;
            paint();
          })
          .catch(function () { eye.disabled = false; out.textContent = 'Could not load'; });
        return;
      }
      shown = !shown;
      paint();
    });
  })();
</script>
