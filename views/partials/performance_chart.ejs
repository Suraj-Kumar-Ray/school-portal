<%
  /* ==========================================================================
     SUBJECT-WISE GRAPH — drawn as SVG on the server, not a canvas chart
     ==========================================================================
     School's request (2026-09-17: “download the result and the graph as one PDF”).
     A canvas is painted by JavaScript AFTER the page loads, so a printed page (and the
     “Save as PDF” the parent taps) could come out with an empty box. These bars are part
     of the HTML: they are there in the first byte, they print, they work with the
     JavaScript switched off, and they read the same on every phone.

     Call it with:
       chart — [{ label, terms: [{ term, value|null }] }] from services/analysis.js
               (`forStudent`), best subject first, exactly the order of the circles.
     `value` is a percentage or null; null means “not entered yet” and its bar is simply
     NOT drawn. Never draw a 0% bar for a term that has no marks.
     ======================================================================= */
  const rows = (typeof chart !== 'undefined' && Array.isArray(chart)) ? chart : [];
  const SERIES = [
    { key: 'Term 1', fill: '#93c5fd' },
    { key: 'Term 2', fill: '#60a5fa' },
    { key: 'Term 3', fill: '#1d4ed8' },
  ];
  // 760 x 214: the bars need room, the empty air above and below them does not. This is also
  // the printed height of the graph (741px of A4 width), and that paper is tight.
  const W = 760, H = 214;
  const padL = 34, padR = 10, padT = 13, padB = 35;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;
  const yOf = (v) => Number((padT + plotH - (Math.max(0, Math.min(100, v)) / 100) * plotH).toFixed(2));
  const bars = rows.length;
  const groupW = plotW / Math.max(1, bars);
  const barW = Math.max(7, Math.min(26, groupW * 0.2));
  const gap = 3;
  const groupBarsW = barW * SERIES.length + gap * (SERIES.length - 1);
  const drawn = rows.some((r) => r.terms.some((t) => t.value !== null));
  /* A caller may drop this panel into a page whose cards fold (the office's view of ONE child,
     2026-09-20): it then passes `cardId` + `foldKey` and the same head the other cards have is
     added here, so this graph behaves like every other card on that page. Callers that pass
     nothing (the parent's Result page) get exactly the panel they always got. */
  /* the folding names are DIFFERENT locals on purpose: re-declaring an incoming EJS local in
     the same scope is a TDZ error, and a caller that predates this must simply get no button */
  const foldCardId = (typeof cardId !== 'undefined' && cardId) ? String(cardId) : '';
  const foldKeyName = (typeof foldKey !== 'undefined' && foldKey) ? String(foldKey) : '';
%>
<%# The id must go out UNESCAPED — an escaped output turns its quotes into HTML entities and
     the card loses the anchor its chip and its remembered fold state hang on. The value is our
     own string built above, never anything a person typed. %>
<div class="panel pg-graph-panel<%= foldCardId ? ' sp-card' : '' %>"<%- foldCardId ? ` id="${foldCardId}"` : '' %>>
  <div class="panel-head">
    <h3>📈 Subject-wise graph</h3>
    <span class="panel-head-note"><%= bars %> subject<%= bars === 1 ? '' : 's' %> · every term as a bar</span>
    <% if (foldKeyName) { %><button type="button" class="sp-fold" data-fold="<%= foldKeyName %>" aria-expanded="true" title="Fold or unfold this card"><span class="sp-fold-ico" aria-hidden="true">▾</span></button><% } %>
  </div>
  <div class="panel-body">
    <% if (!bars || !drawn) { %>
      <div class="rings-empty">📊 No marks have been entered yet — the graph fills in as the school adds results.</div>
    <% } else { %>
      <div class="pg-graph-wrap">
        <svg class="pg-graph" viewBox="0 0 <%= W %> <%= H %>" role="img"
             aria-label="Subject-wise graph: every subject, one bar per term">
          <%# the school's grading bands drawn on the sheet: green from 80 (A), amber 40–80,
              red below 40 (C · Need more hard work) %>
          <rect x="<%= padL %>" y="<%= yOf(100) %>" width="<%= plotW %>" height="<%= (yOf(80) - yOf(100)).toFixed(2) %>" fill="#f0fdf4"></rect>
          <rect x="<%= padL %>" y="<%= yOf(40) %>" width="<%= plotW %>" height="<%= (yOf(0) - yOf(40)).toFixed(2) %>" fill="#fef2f2"></rect>

          <% [100, 90, 80, 70, 60, 50, 40, 0].forEach(v => { %>
            <line x1="<%= padL %>" y1="<%= yOf(v) %>" x2="<%= W - padR %>" y2="<%= yOf(v) %>"
                  stroke="<%= v === 0 ? '#94a3b8' : '#e2e8f0' %>" stroke-width="<%= v === 0 ? 1.4 : 1 %>"
                  <%= v === 0 ? '' : 'stroke-dasharray="4 4"' %>></line>
            <text x="<%= padL - 6 %>" y="<%= yOf(v) + 3.5 %>" text-anchor="end" class="pg-ax"><%= v %></text>
          <% }) %>

          <% rows.forEach((r, i) => {
               const cx = padL + groupW * i + groupW / 2;
               const left = cx - groupBarsW / 2;
               const name = String(r.label || '');
               const shown = name.length > 12 ? name.slice(0, 11) + '…' : name;
          %>
            <g>
              <% SERIES.forEach((s, k) => {
                   const cell = r.terms.find((t) => t.term === s.key);
                   const val = cell ? cell.value : null;
                   if (val === null) return;
                   const x = left + k * (barW + gap);
                   const y = yOf(val);
                   const h = Math.max(2, yOf(0) - y);
              %>
                <rect class="pg-bar" x="<%= x.toFixed(2) %>" y="<%= y %>" width="<%= barW.toFixed(2) %>"
                      height="<%= h.toFixed(2) %>" rx="2.5" fill="<%= s.fill %>">
                  <title><%= name %> · <%= s.key %> · <%= Number(val).toFixed(1) %> of 100</title>
                </rect>
                <text class="pg-bar-num" x="<%= (x + barW / 2).toFixed(2) %>" y="<%= (y - 4).toFixed(2) %>"
                      text-anchor="middle"><%= Number(val).toFixed(1) %></text>
              <% }) %>
              <text class="pg-bar-label" x="<%= cx.toFixed(2) %>" y="<%= H - padB + 18 %>" text-anchor="middle"><%= shown %></text>
            </g>
          <% }) %>
        </svg>
      </div>
      <div class="pg-graph-legend">
        <% SERIES.forEach((s) => { %>
          <span><i style="background: <%= s.fill %>"></i><%= s.key %></span>
        <% }) %>
        <span class="pg-graph-zones">🟩 80%+ A (Excellent / Super) · 🟥 below 40% need more hard work</span>
      </div>
    <% } %>
  </div>
</div>
