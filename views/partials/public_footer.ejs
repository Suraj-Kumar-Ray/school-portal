</main>
  <footer class="public-footer">
    <div class="footer-grid">
      <div class="footer-col quick-links">
        <h4>Quick Links</h4>
        <a href="/">Home</a>
        <a href="/about">About Us</a>
        <a href="/fee-structure">Fee Structure</a>
        <a href="/hostel">Hostel</a>
        <a href="/teachers">Our Teachers</a>
        <a href="/contact">Contact</a>
        <a href="/apply/status">Check Application Status</a>
      </div>

      <div class="footer-col">
        <h4>📍 Address</h4>
        <p class="footer-addr"><%= school.schoolAddress %></p>
        <p class="footer-hours">🕐 <%= school.schoolHours %></p>
      </div>

      <div class="footer-col">
        <h4>📞 Call Us</h4>
        <% school.schoolPhones.forEach(p => { const num = p.number || p; %>
          <a class="footer-phone" href="tel:<%= String(num).replace(/\s+/g, '') %>">📱 <%= num %></a>
        <% }) %>
      </div>

      <div class="footer-col">
        <h4>✉️ Email</h4>
        <% school.schoolEmails.forEach(e => { %>
          <a class="footer-mail" href="mailto:<%= e %>"><%= e %></a>
        <% }) %>
        <a href="/apply" class="footer-apply-btn">📝 Apply for Admission</a>
      </div>
    </div>
    <%- include('./dev_credit') %>
    <div class="footer-bottom">
      <span>© <%= istYear() %> <%= school.schoolName %> · All rights reserved</span>
      <span class="footer-bottom-links"><a href="/apply">Apply</a> · <a href="/login">Login</a></span>
    </div>
  </footer>

  <%# ---- website forms get the same question as the office app: the admission form, the
      contact form … all ask once before they send (see public/js/save-confirm.js).
      A lookup like “Check Application Status” says data-confirm="off" in its own view. ---- %>
  <%- include('./save_confirm') %>
  <script src="/js/save-confirm.js"></script>

  <%# the update tap + the app's front image (public/js/app-update.js) — the same script every
      signed-in page carries, so a website tab left open also learns that the app has moved on %>
  <script src="/js/app-update.js" defer></script>
  <%# and the app's front image (partials/launch_screen.ejs) — shown only when the site is opened
      AS an app, so a browser tab is never covered by it %>
  <%- include('./launch_screen') %>

  <!-- back to top — jump to the top of the page from anywhere -->
  <button id="backToTop" class="back-to-top" aria-label="Back to top" title="Back to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
  </button>
  <script>
    (function () {
      var btn = document.getElementById('backToTop');
      if (!btn) return;
      function onScroll() {
        if (window.scrollY > 350) btn.classList.add('show');
        else btn.classList.remove('show');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</div>
</body>
</html>
