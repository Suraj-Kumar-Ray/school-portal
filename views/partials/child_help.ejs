<%
  // ============================================================
  //  Quick help — call / WhatsApp the school.
  //
  //  The two buttons are FIXED on the screen (bottom-right, see the
  //  .child-help rules in public/css/style.css), so a parent can reach the
  //  school from anywhere on the page without hunting for a block. They are
  //  circles with the real logos: a blue handset and the green WhatsApp mark —
  //  the colours and glyphs do the explaining, the words stay for screen
  //  readers. The WhatsApp text already carries the child's name and class,
  //  and the numbers come from the website settings (school.schoolPhones), so
  //  the office can change them.
  // ============================================================
  const helpKid = (typeof child !== 'undefined' && child) ? child : (locals.child || {});
  const kidClass = [helpKid.class_name, helpKid.section].filter(Boolean).join(' ');
  const kidName = helpKid.full_name || '';

  const toDigits = (v) => String(v || '').replace(/\D/g, '');
  const phoneList = (school.schoolPhones && school.schoolPhones.length ? school.schoolPhones : [school.schoolPhone])
    .map(p => ({ number: (p && p.number) ? p.number : p, whatsapp: !!(p && p.whatsapp) }));
  const mainNumber = toDigits(phoneList[0].number);
  const waNumber = toDigits((phoneList.find(p => p.whatsapp) || phoneList[0]).number);
  // wa.me needs the country code — Indian numbers are saved as 10 digits
  const waFull = (n) => (n.length === 10 ? '91' + n : n);

  // The WhatsApp draft the parent sends — one tap and the message is ready to type into.
  const waText = encodeURIComponent(kidName
    ? `Hello! I am the parent of ${kidName}${kidClass ? ' (' + kidClass + ')' : ''}. I would like to ask about — `
    : 'Hello! I would like to ask a question about my child — ');
%>
<div class="child-help" role="group" aria-label="Call or WhatsApp the school">
  <%# the sentence is read out by a screen reader and is invisible on the screen —
      the circles below explain themselves with the phone/WhatsApp colours and logos %>
  <span class="child-help-label">Need help? Tap to call or WhatsApp the school.</span>
  <a class="child-help-btn ch-call" href="tel:<%= mainNumber %>" title="Call the school office" aria-label="Call the school office">
    <span class="ch-ico">
      <svg class="ch-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
    </span>
    <span class="ch-txt">Call school</span>
  </a>
  <a class="child-help-btn ch-wa" href="https://wa.me/<%= waFull(waNumber) %>?text=<%= waText %>" target="_blank" rel="noopener" title="Message the school on WhatsApp" aria-label="Message the school on WhatsApp">
    <span class="ch-ico">
      <svg class="ch-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </span>
    <span class="ch-txt">WhatsApp</span>
  </a>
</div>
