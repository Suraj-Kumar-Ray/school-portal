<%- include('../partials/header', { title }) %>
<%# ============================================================================
  ONE CHILD'S HOMEWORK — the office's marking page (2026-09-18)
  ----------------------------------------------------------------------------
  The same three buttons the class teacher has, opened from the Students list's
  📝 HW button — the office can settle any child of any class. Nothing marked
  means the parents' timetable band stays plain.
============================================================================ %>
  <div class="page-head flex-between">
    <div>
      <h1>📝 Homework — <%= hwStudent.full_name %></h1>
      <p>
        <% if (hwStudent.class_name) { %><span class="badge blue"><%= hwStudent.class_name %><%= hwStudent.section ? ' ' + hwStudent.section : '' %></span><% } %>
        <% if (hwStudent.roll_no) { %><span class="text-muted" style="margin-left:6px;">Roll No. <%= hwStudent.roll_no %></span><% } %>
      </p>
    </div>
    <div class="head-actions">
      <a href="/admin/students<%= hwStudent.class_name ? '?class=' + hwClassId : '' %>" class="btn btn-outline">← Back to students</a>
    </div>
  </div>

  <%# the day picker: today is pre-picked; yesterday's list can be settled too %>
  <div class="panel">
    <div class="panel-body hw-day-picker">
      <% const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
      <% days.forEach(d => { %>
        <a class="hw-day-chip<%= d === hwDay ? ' active' : '' %><%= d === hwToday ? ' is-today' : '' %>"
           href="/admin/students/<%= hwStudent.id %>/homework?day=<%= d %>"><%= d.slice(0, 3) %></a>
      <% }) %>
    </div>
  </div>

  <%- include('../partials/homework_marker', {
    hwStudent, hwClassId, hwDay, hwPeriods, hwStatuses, hwToday,
    hwBase: `/admin/students/${hwStudent.id}/homework`,
    hwMarked, hwCleared, hwPeriodNotes,
  }) %>
<%- include('../partials/footer') %>
