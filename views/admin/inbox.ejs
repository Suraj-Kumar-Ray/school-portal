<%- include('../partials/header', { title }) %>
  <div class="page-head">
    <h1>📬 School Inbox</h1>
    <p>Notifications generated by the system — new applications, parent logins, and email log. Configure SMTP (see README) to receive these as real emails.</p>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>All notifications</h3><span class="badge blue"><%= notifications.length %> shown</span></div>
    <div class="panel-body">
      <% notifications.forEach(n => { %>
      <div class="notice-item">
        <div class="flex-between">
          <div>
            <div class="notice-title"><span class="badge <%= n.kind === 'email' ? 'orange' : n.kind === 'login' ? 'blue' : 'gray' %>" style="margin-right:6px;"><%= n.kind %></span><%= n.title %></div>
            <div class="notice-meta"><%= fmtDateTime(n.created_at) %> <span class="tz-tag">IST</span></div>
            <div class="notice-body" style="white-space:pre-line;"><%= n.body %></div>
          </div>
        </div>
      </div>
      <% }) %>
      <% if (!notifications.length) { %><div class="empty">No notifications yet.</div><% } %>
    </div>
  </div>
<%- include('../partials/footer') %>