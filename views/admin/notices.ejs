<%- include('../partials/header', { title }) %>
  <div class="page-head">
    <h1>📢 Notices</h1>
    <p>Post announcements for all classes or a specific class.</p>
  </div>

  <% if (query.created) { %><div class="alert success" data-flash="sent">✅ Notice posted! <% if (query.teachersOnly) { %>👔 Visible to <b>teachers only</b> — parents will not see it. <% } else if (query.alerts) { %><%= query.alerts %> SMS/WhatsApp alert<%= query.alerts == 1 ? '' : 's' %> sent to parents — see <a href="/admin/alerts">Parent Alerts</a>.<% } else { %>It will appear on the website &amp; parent portal.<% } %></div><% } %>
  <% if (query.deleted) { %><div class="alert success">🗑️ Notice deleted.</div><% } %>

  <div class="panel">
    <div class="panel-head"><h3>Post a new notice</h3></div>
    <div class="panel-body">
      <form method="POST" action="/admin/notices">
        <div class="form-grid">
          <div class="form-group">
            <label>Title *</label>
            <input type="text" name="title" required placeholder="e.g. Annual Sports Day">
          </div>
          <div class="form-group">
            <label>Send to</label>
            <select name="audience">
              <option value="all" selected>Parents + Teachers (everyone)</option>
              <option value="teachers">Teachers only (parents will not see it)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Audience (class)</label>
            <select name="target_class_id">
              <option value="">All classes</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %><%= c.section ? ' ' + c.section : '' %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <label>Message *</label>
            <textarea name="body" rows="3" required placeholder="Notice details…"></textarea>
          </div>
        </div>
        <div class="mt-3"><button type="submit" class="btn btn-primary">📢 Post Notice</button></div>
      </form>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>All notices</h3></div>
    <div class="panel-body">
      <% notices.forEach(n => { %>
      <div class="notice-item">
        <div class="flex-between">
          <div>
            <div class="notice-title"><%= n.title %></div>
            <div class="notice-meta">
              <%= fmtDate(n.created_at) %>
              · <%= n.class_name || 'All classes' %> · <%= n.posted_by %>
              <% if (n.audience === 'teachers') { %><span class="badge amber" title="Parents cannot see this notice">👔 Teachers only</span><% } %>
            </div>
            <div class="notice-body"><%= n.body %></div>
          </div>
          <form method="POST" action="/admin/notices/<%= n.id %>/delete" onsubmit="return confirm('Delete this notice?');">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <% }) %>
      <% if (!notices.length) { %><div class="empty">No notices posted.</div><% } %>
    </div>
  </div>
<%- include('../partials/footer') %>