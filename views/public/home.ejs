  <!-- CLASS TOPPERS — every class in ONE swipeable row (admin manages: Admin -> Toppers) -->
  <% if (topperGroups.length) {
       // show the percentage exactly as the school entered it —
       // 94.6 stays 94.6, 93.75 stays 93.75, a whole number stays whole
       const fmtPct = (v) => String(Math.round((Number(v) || 0) * 100) / 100);
       const pctWidth = (v) => Math.min(100, Math.max(0, Number(v) || 0));
  %>
  <div class="panel toppers-panel">
    <div class="panel-head">
      <h3><%= home.toppersHeading %></h3>
      <div class="ts-nav">
        <button class="ts-btn" id="tsPrev" aria-label="Previous toppers">❮</button>
        <button class="ts-btn" id="tsNext" aria-label="Next toppers">❯</button>
      </div>
    </div>
    <div class="panel-body">
      <div class="ts-track" id="tsTrack" tabindex="0" role="region" aria-label="Class toppers — swipe or scroll sideways to see every class">
            <% topperGroups.forEach(g => { %>
            <div class="topper-class-card">
              <div class="tcc-head">
                <span class="tcc-accent"></span>
                <span class="tcc-title">🏆 <%= g.class_name %> Toppers</span>
                <span class="tcc-session">Session <%= school.sessionLabel %></span>
              </div>
              <div class="tcc-list">
                <% g.toppers.forEach((t, i) => { %>
                <div class="topper-stu r<%= i + 1 %>">
                  <span class="ts-medal m<%= i + 1 %>"><%= i + 1 %></span>
                  <div class="ts-avatar">
                    <% if (t.photo) { %>
                      <img src="<%= t.photo %>" alt="<%= t.name %>">
                    <% } else { %>
                      <span class="ts-initials"><%= t.name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <div class="ts-name"><%= t.name %></div>
                  <div class="ts-class"><%= g.class_name %></div>
                  <div class="ts-pct"><%= fmtPct(t.percentage) %>%</div>
                  <div class="ts-bar"><i style="width:<%= pctWidth(t.percentage) %>%"></i></div>
                </div>
                <% }) %>
              </div>
            </div>
            <% }) %>
      </div>
      <p class="ts-hint">👈 Swipe / drag sideways to see every class</p>
      <p class="text-muted mt-3" style="text-align:center">Results published by the school — see every detail on the <a href="/login">Parent Portal</a>.</p>
    </div>
  </div>
  <% } %>

