  <script>
    // --- photo slider ---
    (function () {
      var slides = document.querySelectorAll('#homeSlider .hs-slide');
      if (slides.length < 2) return;
      var dotsWrap = document.getElementById('hsDots');
      var dots = [];
      var idx = 0, timer = null;
      slides.forEach(function (s, i) {
        var d = document.createElement('button');
        d.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        d.addEventListener('click', function () { go(i); restart(); });
        dotsWrap.appendChild(d);
        dots.push(d);
      });
      function go(i) {
        slides[idx].classList.remove('active');
        dots[idx].classList.remove('on');
        idx = (i + slides.length) % slides.length;
        slides[idx].classList.add('active');
        dots[idx].classList.add('on');
      }
      function restart() { clearInterval(timer); timer = setInterval(function () { go(idx + 1); }, 5500); }
      document.querySelector('#homeSlider .hs-prev').addEventListener('click', function () { go(idx - 1); restart(); });
      document.querySelector('#homeSlider .hs-next').addEventListener('click', function () { go(idx + 1); restart(); });
      dots[0].classList.add('on');
      timer = setInterval(function () { go(idx + 1); }, 5500);
    })();

    // --- class toppers: ONE swipeable row (scroll-snap); arrows move one card ---
    (function () {
      var track = document.getElementById('tsTrack');
      if (!track) return;
      var prev = document.getElementById('tsPrev');
      var next = document.getElementById('tsNext');
      function cardStep() {
        var card = track.querySelector('.topper-class-card');
        if (!card) return track.clientWidth;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 14;
        return card.getBoundingClientRect().width + gap;
      }
      function sync() {
        var max = track.scrollWidth - track.clientWidth;
        var atStart = track.scrollLeft <= 4;
        var atEnd = track.scrollLeft >= max - 4;
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd || max <= 4;
      }
      function move(dir) { track.scrollBy({ left: dir * cardStep(), behavior: 'smooth' }); }
      if (prev) prev.addEventListener('click', function () { move(-1); });
      if (next) next.addEventListener('click', function () { move(1); });
      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') { e.preventDefault(); move(-1); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); move(1); }
      });
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    })();

    // --- count-up stat numbers ---
    (function () {
      var counters = document.querySelectorAll('.counter');
      if (!counters.length) return;
      function animate(c) {
        var target = parseInt(c.getAttribute('data-target'), 10) || 0;
        var dur = 900, t0 = null;
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / dur, 1);
          c.textContent = Math.round(target * (1 - Math.pow(1 - p, 3))) + (c.getAttribute('data-suffix') || '');
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { animate(e.target); io.unobserve(e.target); }
          });
        }, { threshold: 0.4 });
        counters.forEach(function (c) { io.observe(c); });
      } else { counters.forEach(animate); }
    })();
  </script>

