<%- include('../partials/public_nav', { title }) %>

  <!-- APPLICATION SUBMITTED (success banner, shown once) -->
  <% if (applySuccess) { %>
  <div class="panel applied-banner" style="border: 2px solid #16a34a; background: #f0fdf4;">
    <div class="panel-body" style="text-align:center;">
      <div style="font-size:42px;">🎉</div>
      <h3 style="margin: 4px 0;">Application submitted successfully!</h3>
      <p style="margin: 4px 0;">Thank you, <b><%= applySuccess.parentName %></b> — your application for <b><%= applySuccess.childName %></b> has been received.</p>
      <p style="margin: 10px 0;">
        <span style="display:inline-block; background:#fff; border:2px dashed var(--primary); border-radius:10px; padding:10px 22px; font-size:21px; font-weight:800; color:var(--primary-dark); letter-spacing:1px;"><%= applySuccess.applicationNo %></span>
      </p>
      <p class="text-muted" style="font-size:13px; margin: 4px 0;">Thank you for choosing GREEN VALLEY PUBLIC SCHOOL — our team will soon contact you on <b><%= applySuccess.phone %></b>.</p>
      <% if (applySuccess.waSchool === 'sent') { %>
      <p style="margin:8px 0 0; font-size:13.5px; color:#15803d; font-weight:600;">✅ Your application details have been sent to the school on WhatsApp.</p>
      <% } else if (applySuccess.waChatUrl) { %>
      <!-- Big, unmissable WhatsApp button: opens the school chat with the full form filled in -->
      <div class="wa-btn-wrap">
        <span class="wa-send-hint">👇 Tap here to send your details</span>
        <span class="wa-send-tip" role="tooltip">Click here — your application details will open in WhatsApp</span>
        <a id="waSendBtn" class="wa-send-btn" href="<%= applySuccess.waChatUrl %>" target="_blank" rel="noopener" title="Click here — your application details will open in WhatsApp">
            <svg viewBox="0 0 24 24" width="27" height="27" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.53 0 .2 5.33.2 11.89c0 2.1.55 4.15 1.6 5.96L.1 24l6.3-1.65a11.9 11.9 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.33 11.9-11.89a11.86 11.86 0 0 0-3.47-8.43Zm-8.44 18.27h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.87 9.87 0 0 1-1.51-5.23c0-5.45 4.44-9.88 9.9-9.88a9.84 9.84 0 0 1 6.99 2.9 9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/></svg>
            <span class="wa-send-text">
              <b>Send my details to the school on WhatsApp</b>
              <small>One tap — your complete application reaches the school</small>
            </span>
          <span class="wa-send-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <p id="waNote" style="margin:10px 0 0; font-size:13px; color:var(--muted); font-weight:600;">📲 Opening WhatsApp…</p>
      <script>
        // try to open the school's WhatsApp chat on its own; the green button above
        // is always there as the sure way to send the details
        (function () {
          // the banner has its own big WhatsApp action, so the floating
          // call/WhatsApp buttons step aside and never cover it
          if (document.body) document.body.classList.add('has-applied-banner');
          var url = <%- JSON.stringify(applySuccess.waChatUrl) %>;
          var note = document.getElementById('waNote');
          var opened = null;
          try { opened = window.open(url, '_blank'); } catch (e) { opened = null; }
          if (note) {
            note.innerHTML = opened
              ? '📲 <b>WhatsApp opened in a new tab</b> — press <b>Send</b> there to deliver your details.'
              : '📲 <b>Tap the green button above</b> to send your details to the school.';
          }
        })();
      </script>
      <% } %>
      <div style="margin-top:14px; display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
        <a href="/apply/status" class="btn btn-primary">Check Application Status</a>
        <a href="/" class="btn btn-outline">Back to Home</a>
      </div>
    </div>
  </div>
  <% } %>

